DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shared_calendar

# Optional: ICS feed with waste collection dates (shown in "My calendar")
# COLLECTION_DATES_URL=https://example.com/collection-dates.ics

# Address of this server for the Capacitor mobile app (read by `npm run cap:sync`).
# Use the LAN IP or hostname, not localhost.
# CAP_SERVER_URL=http://192.168.1.50:3000
